  # Leitura do número
    li s0, 0            # Inicializa o contador global s0 com 0
    li a7, 5            
    ecall               # Chama a syscall para ler um número inteiro
    mv t0, a0           # Armazena o número lido em t0

    # Carrega 1000 em t1
    li t1, 1000         

    # Carrega 9999 em t2
    li t2, 9999         

    li s1, 6174         # Armazena o número mágico 6174 em s1

    # Verifica se o número está entre 1000 e 9999
    blt t0, t1, print_invalid   # Se t0 < 1000, imprime erro
    bgt t0, t2, print_invalid   # Se t0 > 9999, imprime erro
    beq t0, s1, caso_zero        # Se t0 == 6174, vai para o caso_zero

kaprekar_loop:

    li t5, 1000          # t5 = 1000
    div t1, t0, t5       
    mul t6, t1, t5       # t6 = t1 * 1000
    sub t0, t0, t6       # t0 = t0 - t6 (remove milhar de t0)

    li t5, 100           # t5 = 100
    div t2, t0, t5       
    mul t6, t2, t5       # t6 = t2 * 100
    sub t0, t0, t6       # t0 = t0 - t6 (remove centena de t0)

    li t5, 10            # t5 = 10
    div t3, t0, t5       # t3 = dezena
    mul t6, t3, t5       # t6 = t3 * 10
    sub t0, t0, t6       # t0 = t0 - t6 (remove dezena de t0)

    mv t4, t0            # t4 = unidade

    # Verificação se todos os dígitos são iguais
    beq t1, t2, check_t3  # Se t1 == t2, verifica t3
    j sort_asc            # Caso contrário, vai ordenar em ordem crescente

check_t3:
    beq t1, t3, check_t4  # Se t1 == t3, verifica t4
    j sort_asc            # Caso contrário, vai ordenar em ordem crescente

check_t4:
    beq t1, t4, print_invalid  # Se t1 == t4, todos os dígitos são iguais, erro
    j sort_asc             # Caso contrário, continua a ordenação

sort_asc:
    # Ordenação crescente utilizando bubble sort
    li t5, 1  # Flag para indicar se houve troca

bubble_sort_asc:
    li t5, 0  # Reseta a flag de troca

    # Comparando t1 e t2
    blt t2, t1, swap_t1_t2  # Se t2 < t1, trocar
    j check_t2_t3           # Caso contrário, verifica t2 e t3

swap_t1_t2:
    mv t6, t1             # Salva t1 em t6
    mv t1, t2             # t1 recebe t2
    mv t2, t6             # t2 recebe t6
    li t5, 1              # Indica que houve troca
    j check_t2_t3         # Verifica t2 e t3

check_t2_t3:
    blt t3, t2, swap_t2_t3  # Se t3 < t2, trocar
    j check_t3_t4            # Caso contrário, verifica t3 e t4

swap_t2_t3:
    mv t6, t2             # Salva t2 em t6
    mv t2, t3             # t2 recebe t3
    mv t3, t6             # t3 recebe t6
    li t5, 1              # Indica que houve troca
    j check_t3_t4         # Verifica t3 e t4

check_t3_t4:
    blt t4, t3, swap_t3_t4  # Se t4 < t3, trocar
    j end_check            # Caso contrário, a ordenação está completa

swap_t3_t4:
    mv t6, t3             # Salva t3 em t6
    mv t3, t4             # t3 recebe t4
    mv t4, t6             # t4 recebe t6
    li t5, 1              # Indica que houve troca

end_check:
    bnez t5, bubble_sort_asc  # Se houve troca, repete o bubble sort
    j done                 # Se não, a ordenação terminou

done:
    li t0, 0
    li t6, 10
    mv t0, t1             # Inicializa t0 com o valor de t1 (unidade)
    mul t2, t2, t6        # t2 = t2 * 10 (dezena)
    add t0, t0, t2        # t0 = t0 + t2 (unidade + dezena)
    div t2, t2, t6
    li t6, 100
    mul t3, t3, t6        # t3 = t3 * 100 (centena)
    add t0, t0, t3       # t0 = t0 + t3 (unidade + dezena + centena)
    div t3, t3, t6
    li t6, 1000
    mul t4, t4, t6        # t4 = t4 * 1000 (milhar)
    add t0, t0, t4        # t0 = t0 + t4 (unidade + dezena + centena + milhar)
    div t4, t4, t6

    # Agora, t1, t2, t3, t4 estão ordenados em ordem crescente
    # Para ordenação decrescente, basta inverter a comparação

sort_desc:
    # Ordenação decrescente utilizando bubble sort
    li t5, 1  # Flag para indicar se houve troca

bubble_sort_desc:
    li t5, 0  # Reseta a flag de troca

    # Comparando t1 e t2
    bge t2, t1, check_t2_t3_desc  # Se t2 >= t1, não trocar
    mv t6, t1             # Salva t1 em t6
    mv t1, t2             # t1 recebe t2
    mv t2, t6             # t2 recebe t6
    li t5, 1              # Indica que houve troca
    j check_t2_t3_desc    # Verifica t2 e t3

check_t2_t3_desc:
    bge t3, t2, check_t3_t4_desc  # Se t3 >= t2, não trocar
    mv t6, t2             # Salva t2 em t6
    mv t2, t3             # t2 recebe t3
    mv t3, t6             # t3 recebe t6
    li t5, 1              # Indica que houve troca
    j check_t3_t4_desc    # Verifica t3 e t4

check_t3_t4_desc:
    bge t4, t3, end_check_desc    # Se t4 >= t3, não trocar
    mv t6, t3             # Salva t3 em t6
    mv t3, t4             # t3 recebe t4
    mv t4, t6             # t4 recebe t6
    li t5, 1              # Indica que houve troca

end_check_desc:
    bnez t5, bubble_sort_desc  # Se houve troca, repete o bubble sort
    j done_desc                # Se não, a ordenação terminou

done_desc:
    li t6, 10
    mv t5, t4             # Inicializa t5 com o valor de t4 (unidade)
    mul t3, t3, t6        # t3 = t3 * 10 (dezena)
    add t5, t5, t3        # t5 = t5 + t3 (unidade + dezena)
    div t3, t3, t6
    li t6, 100
    mul t2, t2, t6        # t2 = t2 * 100 (centena)
    add t5, t5, t2        # t5 = t5 + t2 (unidade + dezena + centena)
    div t2, t2, t6
    li t6, 1000
    mul t1, t1, t6        # t1 = t1 * 1000 (milhar)
    add t5, t5, t1        # t5 = t5 + t1 (unidade + dezena + centena + milhar)
    div t1, t1, t6

    li t6, 0
    sub t6, t0, t5

    li t0, 6174
    addi s0, s0, 1        # Incrementa o contador global
    beq t6, t0, final     # Se t0 == 6174, termina o loop
    mv t0, t6
    j kaprekar_loop       # Repete o loop

final: 
    mv a0, s0            # Passa o contador final para a saída
    li a7, 1
    ecall
    li a0, 10            # Imprime '\n'
    li a7, 11            # syscall 11: print char
    ecall
    j exit

caso_zero:
    li a0, 0             # Caso o número seja 6174, imprime 0
    li a7, 1
    ecall
    li a0, 10            # Imprime '\n'
    li a7, 11            # syscall 11: print char
    ecall
    j exit

exit:
    li a7, 10            # syscall 10: exit
    ecall

print_invalid:
    li a7, 4             # syscall 4: imprime string
    la a0, error_msg     
    ecall
    j exit

.data
error_msg:
    .string "entrada invalida.\n"  # Mensagem de erro
